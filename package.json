{
  "name": "purelab",
  "productName": "PureLab",
  "version": "1.0.0",
  "description": "PureLab — offline-first invoicing & POS for pharmaceutical and dermo-cosmetic sales",
  "author": "PureLab",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/loaymis/purelab.git"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n web,app -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite --host",
    "build:web": "vite build",
    "preview:web": "vite preview --host",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win --x64",
    "dist:dir": "npm run build:web && electron-builder --dir",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.purelab.pos",
    "productName": "PureLab",
    "copyright": "Copyright © PureLab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/*browser*",
      "!node_modules/sql.js/dist/*.mjs"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PureLab-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PureLab",
      "deleteAppDataOnUninstall": false
    },
    "compression": "maximum",
    "publish": null
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "selfsigned": "^2.4.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "html5-qrcode": "^2.3.8",
    "postcss": "^8.5.33",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21",
    "wait-on": "^8.0.5"
  },
  "type": "module"
}
